# Local credentials for `python src/digest.py` (config/digest.yaml).
#
# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed
# and must never carry a real value. Variables already set in the real
# environment win over this file (src/dotenv_lite.py).

# The Gmail address that sends.
IPAD_SMTP_USER=you@gmail.com

# A Google App Password: 16 characters, often shown as four groups of four.
# Not the account password. Needs 2-Step Verification on the account; issue
# one at https://myaccount.google.com/apppasswords
IPAD_SMTP_PASS=xxxx xxxx xxxx xxxx

# Where the digest goes. May be the same address as IPAD_SMTP_USER.
IPAD_DIGEST_TO=you@gmail.com
